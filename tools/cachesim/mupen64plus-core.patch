diff --git a/src/device/r4300/cachesim.c b/src/device/r4300/cachesim.c
new file mode 100644
index 00000000..fd50cabe
--- /dev/null
+++ b/src/device/r4300/cachesim.c
@@ -0,0 +1,244 @@
+/* VR4300 data cache model for GoldenEye cache studies.
+ * 8 KB, direct mapped, 16-byte lines, write-back, write-allocate.
+ * Counts, per physical 16-byte line and per CPU PC, read misses, write misses
+ * and dirty write-backs while enabled. Only KSEG0 (cached) accesses are modelled. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "cachesim.h"
+
+#define EXPORT __attribute__((visibility("default")))
+#define NLINES 512
+#define RAMLINES (0x800000 / 16)
+#define PCSLOTS (0x800000 / 4)
+
+int g_cachesim_on = 0;
+static uint32_t tag[NLINES];       /* physical line number + 1, 0 = invalid */
+static uint8_t dirty[NLINES];
+static uint32_t *line_rmiss, *line_wmiss, *line_wb, *line_acc;
+static uint32_t *pc_miss, *pc_acc;
+static uint64_t tot_acc, tot_rmiss, tot_wmiss, tot_wb, tot_cachewb;
+
+/* Line use: for each resident line, how many accesses it got before it left the cache,
+ * whether it was written, and which instruction filled it. A line filled by a read and
+ * read only once (or twice) before eviction is a candidate for an uncached (KSEG1) read. */
+static uint8_t res_acc[NLINES], res_wrote[NLINES], res_victimdirty[NLINES];
+static uint32_t res_fillpc[NLINES];
+static uint32_t *line_once, *line_twice, *line_fills, *pc_once, *pc_twice, *pc_fills, *line_once_wb;
+static uint64_t tot_once, tot_twice, tot_fills;
+
+#define MAXEVENTS (4 << 20)
+static uint32_t *once_log; static uint32_t n_once_log;
+
+static void usage_retire(uint32_t idx)
+{
+    if (!tag[idx]) return;
+    uint32_t line = tag[idx] - 1, pcs = (res_fillpc[idx] & 0x7fffff) >> 2;
+    int fromkseg0 = (res_fillpc[idx] & 0xe0000000) == 0x80000000;
+    if (res_wrote[idx]) return;
+    tot_fills++; line_fills[line]++; if (fromkseg0) pc_fills[pcs]++;
+    if (res_acc[idx] == 1) {
+        if (!once_log) once_log = malloc(MAXEVENTS * 8);
+        if (n_once_log < MAXEVENTS) { once_log[2 * n_once_log] = line; once_log[2 * n_once_log + 1] = res_fillpc[idx]; n_once_log++; }
+        tot_once++; line_once[line]++; if (fromkseg0) pc_once[pcs]++; if (res_victimdirty[idx]) line_once_wb[line]++; }
+    else if (res_acc[idx] == 2) { tot_twice++; line_twice[line]++; if (fromkseg0) pc_twice[pcs]++; }
+}
+
+static void alloc_arrays(void)
+{
+    if (line_rmiss) return;
+    line_rmiss = calloc(RAMLINES, 4); line_wmiss = calloc(RAMLINES, 4);
+    line_wb = calloc(RAMLINES, 4); line_acc = calloc(RAMLINES, 4);
+    pc_miss = calloc(PCSLOTS, 4); pc_acc = calloc(PCSLOTS, 4);
+    line_once = calloc(RAMLINES, 4); line_twice = calloc(RAMLINES, 4); line_fills = calloc(RAMLINES, 4);
+    line_once_wb = calloc(RAMLINES, 4);
+    pc_once = calloc(PCSLOTS, 4); pc_twice = calloc(PCSLOTS, 4); pc_fills = calloc(PCSLOTS, 4);
+}
+
+/* Instruction count and a 16 KB direct-mapped I-cache with 32-byte lines (KSEG0 code only). */
+static uint32_t itag[512];
+static uint64_t tot_instr, tot_imiss;
+static uint32_t idle_lo, idle_hi;   /* the idle thread's loop: not counted as work */
+EXPORT void cachesim_idle_range(uint32_t lo, uint32_t hi) { idle_lo = lo; idle_hi = hi; }
+void cachesim_ifetch(uint32_t pc)
+{
+    if ((pc & 0xe0000000) != 0x80000000) return;
+    uint32_t line = (pc & 0x7fffff) >> 5, idx = line & 511;
+    if (pc >= idle_lo && pc < idle_hi) { itag[idx] = line + 1; return; }
+    tot_instr++;
+    if (itag[idx] != line + 1) { itag[idx] = line + 1; tot_imiss++; }
+}
+EXPORT void cachesim_icounts(uint64_t *out) { out[0] = tot_instr; out[1] = tot_imiss; }
+
+EXPORT void cachesim_enable(int on) { alloc_arrays(); g_cachesim_on = on; }
+
+EXPORT void cachesim_reset(void)
+{
+    alloc_arrays();
+    memset(line_rmiss, 0, RAMLINES * 4); memset(line_wmiss, 0, RAMLINES * 4);
+    memset(line_wb, 0, RAMLINES * 4); memset(line_acc, 0, RAMLINES * 4);
+    memset(pc_miss, 0, PCSLOTS * 4); memset(pc_acc, 0, PCSLOTS * 4);
+    tot_acc = tot_rmiss = tot_wmiss = tot_wb = tot_cachewb = 0;
+    tot_instr = tot_imiss = 0;
+    memset(line_once, 0, RAMLINES * 4); memset(line_twice, 0, RAMLINES * 4); memset(line_fills, 0, RAMLINES * 4);
+    memset(line_once_wb, 0, RAMLINES * 4);
+    memset(pc_once, 0, PCSLOTS * 4); memset(pc_twice, 0, PCSLOTS * 4); memset(pc_fills, 0, PCSLOTS * 4);
+    tot_once = tot_twice = tot_fills = 0; n_once_log = 0;
+    memset(res_wrote, 1, NLINES);   /* lines already resident at reset are not counted */
+}
+
+EXPORT int cachesim_dump_usage(const char *path)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f) return -1;
+    uint64_t hdr[4] = { 0x43535531, tot_fills, tot_once, tot_twice };
+    fwrite(hdr, 8, 4, f);
+    fwrite(line_fills, 4, RAMLINES, f); fwrite(line_once, 4, RAMLINES, f);
+    fwrite(line_twice, 4, RAMLINES, f); fwrite(line_once_wb, 4, RAMLINES, f);
+    fwrite(pc_fills, 4, PCSLOTS, f); fwrite(pc_once, 4, PCSLOTS, f); fwrite(pc_twice, 4, PCSLOTS, f);
+    fwrite(&n_once_log, 4, 1, f); if (n_once_log) fwrite(once_log, 8, n_once_log, f);
+    fclose(f);
+    return 0;
+}
+
+EXPORT int cachesim_dump(const char *path)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f) return -1;
+    uint64_t hdr[6] = { 0x43534d31, tot_acc, tot_rmiss, tot_wmiss, tot_wb, tot_cachewb };
+    fwrite(hdr, 8, 6, f);
+    fwrite(line_acc, 4, RAMLINES, f); fwrite(line_rmiss, 4, RAMLINES, f);
+    fwrite(line_wmiss, 4, RAMLINES, f); fwrite(line_wb, 4, RAMLINES, f);
+    fwrite(pc_acc, 4, PCSLOTS, f); fwrite(pc_miss, 4, PCSLOTS, f);
+    fclose(f);
+    return 0;
+}
+
+/* Optional per-word counts over one address range, to see which struct members are used. */
+static uint32_t watch_start, watch_len, *watch_acc, *watch_miss;
+
+EXPORT void cachesim_watch(uint32_t vaddr, uint32_t len)
+{
+    free(watch_acc); free(watch_miss);
+    watch_start = vaddr & 0x7fffff; watch_len = len;
+    watch_acc = calloc(len / 4 + 1, 4); watch_miss = calloc(len / 4 + 1, 4);
+}
+
+EXPORT int cachesim_dump_watch(const char *path)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f || !watch_acc) { if (f) fclose(f); return -1; }
+    fwrite(&watch_start, 4, 1, f); fwrite(&watch_len, 4, 1, f);
+    fwrite(watch_acc, 4, watch_len / 4 + 1, f); fwrite(watch_miss, 4, watch_len / 4 + 1, f);
+    fclose(f);
+    return 0;
+}
+
+void cachesim_access(uint32_t vaddr, int write, uint32_t pc)
+{
+    if ((vaddr & 0xe0000000) != 0x80000000) return;     /* KSEG0 only */
+    uint32_t paddr = vaddr & 0x7fffff;
+    uint32_t line = paddr >> 4;
+    uint32_t idx = line & (NLINES - 1);
+    uint32_t pcs = (pc & 0x7fffff) >> 2;
+    tot_acc++; line_acc[line]++;
+    uint32_t woff = paddr - watch_start;
+    int watched = watch_acc && woff < watch_len;
+    if (watched) watch_acc[woff >> 2]++;
+    if ((pc & 0xe0000000) == 0x80000000) pc_acc[pcs]++;
+    if (tag[idx] != line + 1) {
+        usage_retire(idx);
+        res_victimdirty[idx] = tag[idx] && dirty[idx];
+        if (tag[idx] && dirty[idx]) { tot_wb++; line_wb[tag[idx] - 1]++; }
+        tag[idx] = line + 1; dirty[idx] = 0;
+        res_acc[idx] = 0; res_wrote[idx] = write; res_fillpc[idx] = pc;
+        if (write) { tot_wmiss++; line_wmiss[line]++; } else { tot_rmiss++; line_rmiss[line]++; }
+        if ((pc & 0xe0000000) == 0x80000000) pc_miss[pcs]++;
+        if (watched) watch_miss[woff >> 2]++;
+    }
+    if (write) { dirty[idx] = 1; res_wrote[idx] = 1; }
+    if (res_acc[idx] < 255) res_acc[idx]++;
+}
+
+/* CACHE instruction, D-cache operations only (op & 3 == 1). */
+void cachesim_cacheop(uint32_t op, uint32_t vaddr)
+{
+    if ((op & 3) != 1) return;
+    uint32_t line = (vaddr & 0x7fffff) >> 4;
+    uint32_t idx = line & (NLINES - 1);
+    int hit = (vaddr & 0xe0000000) == 0x80000000 && tag[idx] == line + 1;
+    if ((op >> 2) == 0 || (op >> 2) == 2 || (op >> 2) == 3 || (((op >> 2) == 4 || (op >> 2) == 5) && hit)) usage_retire(idx);
+    if ((op >> 2) == 3) { res_wrote[idx] = 1; }
+    switch (op >> 2) {
+    case 0: /* index writeback invalidate */
+        if (tag[idx] && dirty[idx]) tot_cachewb++;
+        tag[idx] = 0; dirty[idx] = 0; break;
+    case 2: /* index store tag (TagLo is 0 when the game clears the cache) */
+        tag[idx] = 0; dirty[idx] = 0; break;
+    case 3: /* create dirty exclusive: no fill */
+        if (tag[idx] && dirty[idx] && tag[idx] != line + 1) { tot_wb++; line_wb[tag[idx] - 1]++; }
+        tag[idx] = line + 1; dirty[idx] = 1; break;
+    case 4: /* hit invalidate */
+        if (hit) { tag[idx] = 0; dirty[idx] = 0; } break;
+    case 5: /* hit writeback invalidate */
+        if (hit) { if (dirty[idx]) tot_cachewb++; tag[idx] = 0; dirty[idx] = 0; } break;
+    case 6: /* hit writeback */
+        if (hit && dirty[idx]) { tot_cachewb++; dirty[idx] = 0; } break;
+    }
+}
+
+/* Allocation tracking: when the CPU enters one of the allocator entry points, note the
+ * size (a0) and the caller (ra); when it reaches ra again, v0 is the block. Each 16-byte
+ * line remembers the last block that covered it, so heap misses can be named by the
+ * function that allocated them. */
+#define MAXBLOCKS 65536
+struct csblock { uint32_t addr, size, caller, entry; };
+static struct csblock blocks[MAXBLOCKS];
+static uint32_t nblocks;
+static uint32_t *line_owner;          /* block index + 1 */
+uint32_t g_cachesim_alloc_pc[4];
+int g_cachesim_alloc_n;
+static struct { uint32_t ra, size, entry; } pending[16];
+static int npending;
+
+EXPORT void cachesim_track_alloc(uint32_t entry_pc)
+{
+    if (!line_owner) line_owner = calloc(RAMLINES, 4);
+    if (g_cachesim_alloc_n < 4) g_cachesim_alloc_pc[g_cachesim_alloc_n++] = entry_pc;
+}
+
+void cachesim_pc(uint32_t pc, const int64_t *regs)
+{
+    if (npending && pc == pending[npending - 1].ra) {
+        npending--;
+        uint32_t v0 = (uint32_t)regs[2];
+        uint32_t size = pending[npending].size;
+        if (v0 && size && size < 0x800000 && nblocks < MAXBLOCKS) {
+            blocks[nblocks] = (struct csblock){ v0, size, pending[npending].ra, pending[npending].entry };
+            nblocks++;
+            uint32_t a = v0 & 0x7fffff, end = a + size;
+            if (end > 0x800000) end = 0x800000;
+            for (uint32_t l = a >> 4; l < (end + 15) >> 4; l++) line_owner[l] = nblocks;
+        }
+    }
+    for (int i = 0; i < g_cachesim_alloc_n; i++) {
+        if (pc == g_cachesim_alloc_pc[i] && npending < 16) {
+            pending[npending].ra = (uint32_t)regs[31];
+            pending[npending].size = (uint32_t)regs[4];
+            pending[npending].entry = pc;
+            npending++;
+        }
+    }
+}
+
+EXPORT int cachesim_dump_blocks(const char *path)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f) return -1;
+    fwrite(&nblocks, 4, 1, f);
+    fwrite(blocks, sizeof(struct csblock), nblocks, f);
+    if (line_owner) fwrite(line_owner, 4, RAMLINES, f);
+    fclose(f);
+    return 0;
+}
